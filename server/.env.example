# =====================================================
# SERVER CONFIGURATION
# =====================================================

# Application port
PORT=3000


# =====================================================
# DATABASE CONFIGURATION
# =====================================================

# Local MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/bookent

# MongoDB Atlas connection string
MONGODB_ATLAS_URI=


# =====================================================
# AUTHENTICATION & SECURITY
# =====================================================

# Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT secrets (keep these strong & private)
JWT_SECRET=
JWT_REFRESH_SECRET=

# JWT expiry durations (examples: 15m, 7d, 30d)
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_USER_REFRESH_TOKEN_EXPIRES_IN=7d
JWT_ADMIN_REFRESH_TOKEN_EXPIRES_IN=1d


# =====================================================
# EMAIL (NODEMAILER)
# =====================================================

# Email used for sending notifications
EMAIL=
PASSWORD=


# =====================================================
# FRONTEND
# =====================================================

# Frontend base URL
FRONTEND_URL=http://localhost:5173


# =====================================================
# LOCATION & MAP SERVICES
# =====================================================

# Location API key
LOCATION_API_KEY=

# Google Maps API URL
GOOGLE_MAP_URI=


# =====================================================
# REDIS CONFIGURATION
# =====================================================

REDIS_URI=redis://127.0.0.1:6379

# Expiry values in seconds
REDIS_OTP_EXPIRES_IN=300
REDIS_EVENT_VALIDATION_EXPIRES_IN=600


# =====================================================
# AWS S3 STORAGE
# =====================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=

# Signed URL expiry (seconds)
AWS_SIGNED_URI_EXPIRES_IN=300


# =====================================================
# OAUTH CALLBACKS
# =====================================================

GOOGLE_CALLBACK_URL=


# =====================================================
# BRANDING
# =====================================================

# Public logo URL
LOGO_URL=


# =====================================================
# LOGGING
# =====================================================

# Log levels: error | warn | info | debug
LOG_LEVEL=info


# =====================================================
# DISTRIBUTED LOCKING (REDIS)
# =====================================================

LOCK_TTL=300000
LOCKMETA_TTL=5000
LOCK_EXTEND_TTL=600
LOCKMETA_EXTEND_TTL=5


# =====================================================
# PAYPAL CONFIGURATION
# =====================================================

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=


# =====================================================
# CURRENCY & EXCHANGE
# =====================================================

CURRENCY_API_KEY=
OPEN_EXCHANGES_RATE_URL=


# =====================================================
# BOOKING & ORDER RULES
# =====================================================

# Hours before event when booking is blocked
BOOKING_BLOCK_HOURS=4

# QR code & order security
CREATE_ORDER_QR_CODE_EXPIRY=10y
QR_DATA_JWT_SECRET=


# =====================================================
# CRON JOBS
# =====================================================

# Cron expression for cleaning expired orders
ORDER_CLEANUP_CRON=*/10 * * * *